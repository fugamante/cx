+bool llama_kv_cache::turboquant_supported_v(const ggml_tensor * v_cur) const {
+    if (!turboquant.enable || v_cur == nullptr) {
+        return false;
+    }
+
+    if (v_trans) {
+        return false;
+    }
+
+    if (turboquant.group_size == 0 || turboquant.codebook_bits == 0) {
+        return false;
+    }
+
+    if (v_cur->type != GGML_TYPE_F16 && v_cur->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    const int64_t n_embd_gqa = v_cur->ne[0]*v_cur->ne[1];
+    return n_embd_gqa % turboquant.group_size == 0;
+}
+
+bool llama_kv_cache::turboquant_supported_backend_v(const ggml_tensor * v_dst) const {
+    if (!turboquant.enable || v_dst == nullptr || v_dst->buffer == nullptr) {
+        return false;
+    }
+
+    return ggml_backend_buffer_is_host(v_dst->buffer);
+}
+
+void llama_kv_cache::turboquant_set_fallback(const char * reason) const {
+    if (!turboquant.enable) {
+        return;
+    }
+
+    const char * why = reason ? reason : "unknown";
+    if (!turboquant_fallback || turboquant_fallback_reason != why) {
+        LLAMA_LOG_WARN("%s: turboquant fallback active for V cache: %s\n", __func__, why);
+    }
+
+    turboquant_fallback = true;
+    turboquant_fallback_reason = why;
+}
+
+bool llama_kv_cache::turboquant_is_active_v() const {
+    return turboquant.enable && !turboquant_fallback;
+}
+
+void llama_kv_cache::turboquant_reset_sidecar(tq_v_layer_state & layer) const {
+    layer.row_width = 0;
+    layer.row_count = 0;
+    layer.payload_bytes = 0;
+    layer.scale_bytes = 0;
+    layer.rows_written = 0;
+    layer.rows_bypassed = 0;
+    layer.sidecar.payload.clear();
+    layer.sidecar.scales_fp16.clear();
+    layer.sidecar.rows.clear();
+}
+
+void llama_kv_cache::turboquant_sync_sidecar_v(const ggml_tensor * v_dst, int32_t il, uint32_t n_kv, const slot_info & sinfo) const {
+    if (!turboquant_is_active_v() || v_dst == nullptr || v_trans) {
+        return;
+    }
+
+    const int32_t ikv = map_layer_ids.at(il);
+    auto & layer = tq_v_layers.at(ikv);
+    turboquant_reset_sidecar(layer);
+
+    const uint32_t width = uint32_t(v_dst->ne[0]);
+    const uint32_t group_size = std::max<uint32_t>(1, layer.group_size);
+    const uint32_t bits = std::max<uint32_t>(1, layer.codebook_bits);
+    const int32_t qmax = std::max<int32_t>(1, (1 << (std::min<uint32_t>(bits, 15u) - 1)) - 1);
+    const size_t elem_size = ggml_type_size(v_dst->type);
+
+    layer.row_width = width;
+    layer.row_count = n_kv * sinfo.n_stream();
+    layer.raw_bytes = size_t(layer.row_width) * size_t(layer.row_count) * elem_size;
+
+    for (uint32_t si = 0; si < sinfo.n_stream(); ++si) {
+        const uint32_t strm = sinfo.strm[si];
+        for (uint32_t slot = 0; slot < n_kv; ++slot) {
+            tq_v_group row;
+            row.slot = slot;
+            row.strm = strm;
+            row.width = width;
+            row.payload_offset = layer.sidecar.payload.size();
+            row.scale_offset = layer.sidecar.scales_fp16.size();
+
+            size_t bit_cursor = row.payload_offset * 8u;
+            uint32_t code_count = 0;
+
+            for (uint32_t base = 0; base < width; base += group_size) {
+                const uint32_t group_width = std::min<uint32_t>(group_size, width - base);
+                float max_abs = 0.0f;
+                std::vector<float> values(group_width);
+                for (uint32_t j = 0; j < group_width; ++j) {
+                    const float value = tq_tensor_get_f32(v_dst, base + j, slot, strm, 0);
+                    values[j] = value;
+                    max_abs = std::max(max_abs, std::fabs(value));
+                }
+
+                const float scale = max_abs > 0.0f ? (max_abs / float(qmax)) : 0.0f;
+                layer.sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(scale));
+
+                for (uint32_t j = 0; j < group_width; ++j) {
+                    uint32_t packed = 0;
+                    if (scale > 0.0f) {
+                        const float qf = std::round(values[j] / scale);
+                        const float qc = std::max(-float(qmax), std::min(float(qmax), qf));
+                        packed = uint32_t(int32_t(qc) + qmax);
+                    }
+                    tq_pack_bits(layer.sidecar.payload, bit_cursor, packed, bits);
+                    ++code_count;
+                }
+            }
+
+            row.code_count = code_count;
+            row.payload_bytes = layer.sidecar.payload.size() - row.payload_offset;
+            row.scale_count = layer.sidecar.scales_fp16.size() - row.scale_offset;
+            layer.sidecar.rows.push_back(row);
+            ++layer.rows_written;
+        }
+    }
+
+    layer.payload_bytes = layer.sidecar.payload.size();
+    layer.scale_bytes = layer.sidecar.scales_fp16.size() * sizeof(uint16_t);
+    layer.simulated_bytes = layer.payload_bytes + layer.scale_bytes;
+}
