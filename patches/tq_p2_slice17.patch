+bool llama_kv_cache::turboquant_supported_v(const ggml_tensor * v_cur) const {
+    if (!turboquant.enable || v_cur == nullptr) {
+        return false;
+    }
+
+    if (v_trans) {
+        return false;
+    }
+
+    if (turboquant.group_size == 0 || turboquant.codebook_bits == 0) {
+        return false;
+    }
+
+    if (v_cur->type != GGML_TYPE_F16 && v_cur->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    const int64_t n_embd_gqa = v_cur->ne[0]*v_cur->ne[1];
+    return n_embd_gqa % turboquant.group_size == 0;
+}
+
+bool llama_kv_cache::turboquant_supported_backend_v(const ggml_tensor * v_dst) const {
+    if (!turboquant.enable || v_dst == nullptr || v_dst->buffer == nullptr) {
+        return false;
+    }
+
+    return ggml_backend_buffer_is_host(v_dst->buffer);
+}
+
+void llama_kv_cache::turboquant_set_fallback(const char * reason) const {
+    if (!turboquant.enable) {
+        return;
+    }
+
+    const char * why = reason ? reason : "unknown";
+    if (!turboquant_fallback || turboquant_fallback_reason != why) {
+        LLAMA_LOG_WARN("%s: turboquant fallback active for V cache: %s\n", __func__, why);
+    }
+
+    turboquant_fallback = true;
+    turboquant_fallback_reason = why;
+}
+
+bool llama_kv_cache::turboquant_is_active_v() const {
+    return turboquant.enable && !turboquant_fallback;
+}
+
+void llama_kv_cache::turboquant_reset_sidecar(tq_v_layer_state & layer) const {
+    layer.row_width = 0;
+    layer.row_count = 0;
+    layer.payload_bytes = 0;
+    layer.scale_bytes = 0;
+    layer.rows_written = 0;
+    layer.rows_bypassed = 0;
+    layer.rows_evicted = 0;
+    layer.decode_calls = 0;
+    layer.decode_rows = 0;
+    layer.evicted_bytes = 0;
+    layer.raw_evicted = false;
+    layer.last_reported_sidecar_bytes = 0;
+    layer.last_reported_row_count = 0;
+    layer.last_reported_decode_calls = 0;
+    layer.sidecar.payload.clear();
+    layer.sidecar.scales_fp16.clear();
+    layer.sidecar.rows.clear();
+}
+
+bool llama_kv_cache::turboquant_raw_eviction_enabled() const {
+    if (!turboquant_is_active_v()) {
+        return false;
+    }
+
+    const char * enabled = getenv("LLAMA_TQ_EVICT_RAW_V");
+    return enabled != nullptr && atoi(enabled) != 0;
+}
+
+void llama_kv_cache::turboquant_report_sidecar_v(const tq_v_layer_state & layer) const {
+    const size_t sidecar_bytes = layer.payload_bytes + layer.scale_bytes;
+    if (sidecar_bytes == layer.last_reported_sidecar_bytes &&
+        layer.row_count == layer.last_reported_row_count &&
+        layer.decode_calls == layer.last_reported_decode_calls) {
+        return;
+    }
+
+    const double raw_ratio = layer.raw_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(layer.raw_bytes)) : 0.0;
+    const double sim_ratio = layer.simulated_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(layer.simulated_bytes)) : 0.0;
+
+    LLAMA_LOG_INFO("%s: layer %u V sidecar rows=%zu raw=%zuB sidecar=%zuB simulated=%zuB raw_ratio=%.2f%% sim_ratio=%.2f%% bypassed=%zu\n",
+            __func__,
+            layer.il,
+            layer.rows_written,
+            layer.raw_bytes,
+            sidecar_bytes,
+            layer.simulated_bytes,
+            raw_ratio,
+            sim_ratio,
+            layer.rows_bypassed);
+
+    if (layer.raw_evicted) {
+        LLAMA_LOG_INFO("%s: layer %u raw V eviction rows=%zu bytes=%zuB\n",
+                __func__,
+                layer.il,
+                layer.rows_evicted,
+                layer.evicted_bytes);
+    }
+
+    if (layer.decode_calls > 0) {
+        LLAMA_LOG_INFO("%s: layer %u sidecar decode calls=%zu rows=%zu\n",
+                __func__,
+                layer.il,
+                layer.decode_calls,
+                layer.decode_rows);
+    }
+
+    const char * tq_report = getenv("LLAMA_TQ_REPORT");
+    if (tq_report && atoi(tq_report) != 0) {
+        fprintf(stderr,
+                "turboquant_report: layer=%u rows=%zu raw=%zu sidecar=%zu simulated=%zu raw_ratio=%.2f sim_ratio=%.2f bypassed=%zu evicted_rows=%zu evicted_bytes=%zu decode_calls=%zu decode_rows=%zu\n",
+                layer.il,
+                layer.rows_written,
+                layer.raw_bytes,
+                sidecar_bytes,
+                layer.simulated_bytes,
+                raw_ratio,
+                sim_ratio,
+                layer.rows_bypassed,
+                layer.rows_evicted,
+                layer.evicted_bytes,
+                layer.decode_calls,
+                layer.decode_rows);
+    }
+
+    auto & mutable_layer = const_cast<tq_v_layer_state &>(layer);
+    mutable_layer.last_reported_sidecar_bytes = sidecar_bytes;
+    mutable_layer.last_reported_row_count = layer.row_count;
+    mutable_layer.last_reported_decode_calls = layer.decode_calls;
+}
+
+size_t llama_kv_cache::turboquant_sidecar_bytes() const {
+    size_t total = 0;
+    for (const auto & layer : tq_v_layers) {
+        total += layer.payload_bytes + layer.scale_bytes;
+    }
+    return total;
+}
+
+size_t llama_kv_cache::turboquant_simulated_bytes() const {
+    size_t total = 0;
+    for (const auto & layer : tq_v_layers) {
+        total += layer.simulated_bytes;
+    }
+    return total;
+}
+
+void llama_kv_cache::turboquant_capture_sidecar_v(const ggml_tensor * v_src, tq_v_layer_state & layer) const {
+    if (!turboquant_is_active_v() || v_src == nullptr || v_trans) {
+        return;
+    }
+    turboquant_report_sidecar_v(layer);
+}
