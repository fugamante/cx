index 3e0fd31..df40112 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -6,6 +6,7 @@
 #include "llama-context.h"
 
 #include <algorithm>
+#include <array>
 #include <cassert>
 #include <cmath>
 #include <cstring>
@@ -72,6 +73,560 @@ static ggml_tensor * ggml_mul_mat_aux(
     return res;
 }
 
+static void tq_v0_identity_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    GGML_UNUSED(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+    GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(src));
+
+    memcpy(dst->data, src->data, ggml_nbytes(src));
+}
+
+static void tq_v0_zero_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    GGML_UNUSED(src);
+    GGML_UNUSED(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(nth >= 1);
+    memset(dst->data, 0, ggml_nbytes(dst));
+}
+
+static size_t tq_tensor_offset(const ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
+    return size_t(i0)*tensor->nb[0] + size_t(i1)*tensor->nb[1] + size_t(i2)*tensor->nb[2] + size_t(i3)*tensor->nb[3];
+}
+
+static float tq_tensor_get_f32(const ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
+    const size_t off = tq_tensor_offset(tensor, i0, i1, i2, i3);
+    const char * base = static_cast<const char *>(tensor->data) + off;
+
+    switch (tensor->type) {
+        case GGML_TYPE_F32:
+            return *reinterpret_cast<const float *>(base);
+        case GGML_TYPE_F16:
+            return ggml_fp16_to_fp32(*reinterpret_cast<const ggml_fp16_t *>(base));
+        default:
+            GGML_ABORT("unsupported tq tensor type");
+    }
+}
+
+static void tq_tensor_set_f32(ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3, float value) {
+    const size_t off = tq_tensor_offset(tensor, i0, i1, i2, i3);
+    char * base = static_cast<char *>(tensor->data) + off;
+
+    switch (tensor->type) {
+        case GGML_TYPE_F32:
+            *reinterpret_cast<float *>(base) = value;
+            return;
+        case GGML_TYPE_F16:
+            *reinterpret_cast<ggml_fp16_t *>(base) = ggml_fp32_to_fp16(value);
+            return;
+        default:
+            GGML_ABORT("unsupported tq tensor type");
+    }
+}
+
+static void tq_pack_bits(std::vector<uint8_t> & dst, size_t & bit_cursor, uint32_t value, uint32_t bits);
+static void tq_fwht_norm(std::vector<float> & values);
+static void tq_append_bytes(std::vector<uint8_t> & dst, const void * src, size_t n);
+
+enum class tq_codec_mode {
+    scalar,
+    residual,
+    projection,
+};
+
+static tq_codec_mode tq_codec_mode_current() {
+    const char * mode = getenv("LLAMA_TQ_CODEC_MODE");
+    if (mode == nullptr || mode[0] == '\0') {
+        return tq_codec_mode::projection;
+    }
+    if (strcmp(mode, "scalar") == 0) {
+        return tq_codec_mode::scalar;
+    }
+    if (strcmp(mode, "residual") == 0) {
+        return tq_codec_mode::residual;
+    }
+    if (strcmp(mode, "projection") == 0) {
+        return tq_codec_mode::projection;
+    }
+    return tq_codec_mode::projection;
+}
+
+static void tq_v0_simulate_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    auto * params = static_cast<llama_kv_cache::tq_v_layer_state *>(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(params != nullptr);
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+
+    params->row_width = uint32_t(src->ne[0] * src->ne[1]);
+    params->row_count = uint32_t(src->ne[2] * src->ne[3]);
+    params->raw_bytes = ggml_nbytes(src);
+    params->payload_bytes = 0;
+    params->scale_bytes = 0;
+    params->rows_written = 0;
+    params->rows_bypassed = 0;
+    params->sidecar.payload.clear();
+    params->sidecar.scales_fp16.clear();
+    params->sidecar.rows.clear();
+
+    const int64_t * v_idx_data = nullptr;
+    size_t v_idx_count = 0;
+    if (params->pending_v_idxs != nullptr) {
+        GGML_ASSERT(params->pending_v_idxs->type == GGML_TYPE_I64);
+        v_idx_data = static_cast<const int64_t *>(params->pending_v_idxs->data);
+        v_idx_count = ggml_nelements(params->pending_v_idxs);
+    }
+
+    const uint32_t group_size = std::max<uint32_t>(1, params->group_size);
+    const uint32_t codebook_bits = std::max<uint32_t>(1, params->codebook_bits);
+    const uint32_t qlevels = std::max<uint32_t>(1, (1u << std::min<uint32_t>(codebook_bits, 15u)) - 1u);
+    const char * ceiling_env = getenv("LLAMA_TQ_CEILING_RAW");
+    const bool ceiling_raw = ceiling_env && atoi(ceiling_env) != 0;
+    const tq_codec_mode codec_mode = tq_codec_mode_current();
+
+    std::vector<float> group;
+    group.reserve(group_size);
+    size_t row_bit_cursor = 0;
+
+    auto flush_group = [&](std::vector<std::array<int64_t, 4>> & coords) {
+        if (group.empty()) {
+            return;
+        }
+
+        if (ceiling_raw) {
+            for (size_t i = 0; i < group.size(); ++i) {
+                const auto & c = coords[i];
+                const float value = group[i];
+                switch (params->cache_type) {
+                    case GGML_TYPE_F32: {
+                        tq_append_bytes(params->sidecar.payload, &value, sizeof(float));
+                        break;
+                    }
+                    case GGML_TYPE_F16: {
+                        const ggml_fp16_t fp16 = ggml_fp32_to_fp16(value);
+                        tq_append_bytes(params->sidecar.payload, &fp16, sizeof(fp16));
+                        break;
+                    }
+                    default:
+                        GGML_ABORT("unsupported turboquant cache_type");
+                }
+                tq_tensor_set_f32(dst, c[0], c[1], c[2], c[3], value);
+            }
+            group.clear();
+            coords.clear();
+            return;
+        }
+
+        std::vector<float> work = group;
+        const bool use_projection = codec_mode == tq_codec_mode::projection;
+        const bool use_residual = codec_mode == tq_codec_mode::residual;
+        if (use_projection && work.size() > 1 && ggml_is_power_of_2((int) work.size())) {
+            tq_fwht_norm(work);
+        }
+
+        float vmin = std::numeric_limits<float>::infinity();
+        float vmax = -std::numeric_limits<float>::infinity();
+        for (float v : work) {
+            vmin = std::min(vmin, v);
+            vmax = std::max(vmax, v);
+        }
+
+        const float span = vmax - vmin;
+        const float scale = span > 0.0f ? (span / float(qlevels)) : 0.0f;
+        params->sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(vmin));
+        params->sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(scale));
+
+        std::vector<float> decoded(work.size(), 0.0f);
+        std::vector<float> residual(work.size(), 0.0f);
+        float rmin = std::numeric_limits<float>::infinity();
+        float rmax = -std::numeric_limits<float>::infinity();
+
+        for (size_t i = 0; i < work.size(); ++i) {
+            uint32_t packed = 0;
+            if (scale > 0.0f) {
+                const float qf = std::round((work[i] - vmin) / scale);
+                const float qc = std::max(0.0f, std::min(float(qlevels), qf));
+                decoded[i] = vmin + qc * scale;
+                packed = uint32_t(qc);
+            } else {
+                decoded[i] = vmin;
+            }
+            tq_pack_bits(params->sidecar.payload, row_bit_cursor, packed, codebook_bits);
+            if (use_residual) {
+                residual[i] = work[i] - decoded[i];
+                rmin = std::min(rmin, residual[i]);
+                rmax = std::max(rmax, residual[i]);
+            }
+        }
+
+        if (use_residual) {
+            const float rspan = rmax - rmin;
+            const float rscale = rspan > 0.0f ? (rspan / float(qlevels)) : 0.0f;
+            params->sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(rmin));
+            params->sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(rscale));
+            for (size_t i = 0; i < work.size(); ++i) {
+                uint32_t packed = 0;
+                if (rscale > 0.0f) {
+                    const float qf = std::round((residual[i] - rmin) / rscale);
+                    const float qc = std::max(0.0f, std::min(float(qlevels), qf));
+                    decoded[i] += rmin + qc * rscale;
+                    packed = uint32_t(qc);
+                } else {
+                    decoded[i] += rmin;
+                }
+                tq_pack_bits(params->sidecar.payload, row_bit_cursor, packed, codebook_bits);
+            }
+        }
+
+        if (use_projection && decoded.size() > 1 && ggml_is_power_of_2((int) decoded.size())) {
+            tq_fwht_norm(decoded);
+        }
+        for (size_t i = 0; i < decoded.size(); ++i) {
+            const auto & c = coords[i];
+            tq_tensor_set_f32(dst, c[0], c[1], c[2], c[3], decoded[i]);
+        }
+
+        group.clear();
+        coords.clear();
+    };
+
+    std::vector<std::array<int64_t, 4>> coords;
+    coords.reserve(group_size);
+    llama_kv_cache::tq_v_group row;
+    bool row_open = false;
+    size_t row_linear = 0;
+
+    for (int64_t i3 = 0; i3 < dst->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < dst->ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < dst->ne[1]; ++i1) {
+                if (!row_open) {
+                    row = {};
+                    if (v_idx_data != nullptr && row_linear < v_idx_count && params->kv_size > 0) {
+                        const int64_t absolute = v_idx_data[row_linear];
+                        GGML_ASSERT(absolute >= 0);
+                        row.slot = uint32_t(absolute % params->kv_size);
+                        row.strm = uint32_t(absolute / params->kv_size);
+                    } else {
+                        row.slot = uint32_t(i2);
+                        row.strm = uint32_t(i3);
+                    }
+                    row.width = uint32_t(dst->ne[0] * dst->ne[1]);
+                    row.payload_offset = params->sidecar.payload.size();
+                    row.scale_offset = params->sidecar.scales_fp16.size();
+                    row_bit_cursor = row.payload_offset * 8u;
+                    row_open = true;
+                }
+                for (int64_t i0 = 0; i0 < dst->ne[0]; ++i0) {
+                    group.push_back(tq_tensor_get_f32(src, i0, i1, i2, i3));
+                    coords.push_back({i0, i1, i2, i3});
+
+                    if (group.size() == group_size) {
+                        flush_group(coords);
+                    }
+                }
+            }
+            if (row_open) {
+                flush_group(coords);
+                row.code_count = row.width;
+                row.payload_bytes = params->sidecar.payload.size() - row.payload_offset;
+                row.scale_count = params->sidecar.scales_fp16.size() - row.scale_offset;
+                params->sidecar.rows.push_back(row);
+                ++params->rows_written;
+                ++row_linear;
+                row_open = false;
+            }
+        }
+    }
+
+    GGML_ASSERT(group.empty());
+    GGML_ASSERT(coords.empty());
+    params->payload_bytes = params->sidecar.payload.size();
+    params->scale_bytes = params->sidecar.scales_fp16.size() * sizeof(uint16_t);
+    params->simulated_bytes = params->payload_bytes + params->scale_bytes;
+    params->pending_v_idxs = nullptr;
+
+    const char * tq_report = getenv("LLAMA_TQ_REPORT");
+    if (tq_report && atoi(tq_report) != 0) {
+        const size_t sidecar_bytes = params->payload_bytes + params->scale_bytes;
+        const double raw_ratio = params->raw_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(params->raw_bytes)) : 0.0;
+        const double sim_ratio = params->simulated_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(params->simulated_bytes)) : 0.0;
+        fprintf(stderr,
+                "turboquant_report: layer=%u rows=%zu raw=%zu sidecar=%zu simulated=%zu raw_ratio=%.2f sim_ratio=%.2f bypassed=%zu\n",
+                params->il,
+                params->rows_written,
+                params->raw_bytes,
+                sidecar_bytes,
+                params->simulated_bytes,
+                raw_ratio,
+                sim_ratio,
+                params->rows_bypassed);
+    }
+}
+
+static void tq_pack_bits(std::vector<uint8_t> & dst, size_t & bit_cursor, uint32_t value, uint32_t bits) {
+    if (bits == 0) {
+        return;
+    }
+    for (uint32_t i = 0; i < bits; ++i) {
+        const uint32_t bit = (value >> i) & 1u;
+        const size_t byte_idx = bit_cursor / 8u;
+        const uint32_t bit_idx = bit_cursor % 8u;
+        if (byte_idx >= dst.size()) {
+            dst.push_back(0);
+        }
+        dst[byte_idx] |= uint8_t(bit << bit_idx);
+        ++bit_cursor;
+    }
+}
+
+static uint32_t tq_unpack_bits(const std::vector<uint8_t> & src, size_t bit_offset, uint32_t bits) {
+    uint32_t value = 0;
+    for (uint32_t i = 0; i < bits; ++i) {
+        const size_t bit_index = bit_offset + i;
+        const size_t byte_idx = bit_index / 8u;
+        const uint32_t byte_bit = bit_index % 8u;
+        if (byte_idx >= src.size()) {
+            break;
+        }
+        const uint32_t bit = (src[byte_idx] >> byte_bit) & 1u;
+        value |= (bit << i);
+    }
+    return value;
+}
+
+static void tq_append_bytes(std::vector<uint8_t> & dst, const void * src, size_t n) {
+    const uint8_t * p = reinterpret_cast<const uint8_t *>(src);
+    dst.insert(dst.end(), p, p + n);
+}
+
+static void tq_fwht_norm(std::vector<float> & values) {
+    const size_t n = values.size();
+    if (n <= 1) {
+        return;
+    }
+    GGML_ASSERT(ggml_is_power_of_2((int) n));
+    for (size_t len = 1; len < n; len <<= 1) {
+        for (size_t i = 0; i < n; i += (len << 1)) {
+            for (size_t j = 0; j < len; ++j) {
+                const float a = values[i + j];
+                const float b = values[i + j + len];
+                values[i + j] = a + b;
+                values[i + j + len] = a - b;
+            }
+        }
+    }
+    const float scale = 1.0f / std::sqrt((float) n);
+    for (float & v : values) {
+        v *= scale;
+    }
+}
+
+static void tq_v0_sidecar_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    auto * layer = static_cast<llama_kv_cache::tq_v_layer_state *>(userdata);
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(layer != nullptr);
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+    GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(src));
+
+    memcpy(dst->data, src->data, ggml_nbytes(src));
+
+    layer->decode_calls += 1;
+
+    const uint32_t group_size = std::max<uint32_t>(1, layer->group_size);
+    const uint32_t bits = std::max<uint32_t>(1, layer->codebook_bits);
+    const uint32_t head_width = uint32_t(dst->ne[0]);
+    const uint32_t n_head = uint32_t(dst->ne[1]);
+    const uint32_t width = head_width * n_head;
+    const char * trace_error = getenv("LLAMA_TQ_TRACE_ERROR");
+    const char * trace_first = getenv("LLAMA_TQ_TRACE_FIRST_MISMATCH");
+    const char * ceiling_env = getenv("LLAMA_TQ_CEILING_RAW");
+    const char * loop_copy_env = getenv("LLAMA_TQ_FORCE_LOOP_COPY");
+    const bool ceiling_raw = ceiling_env && atoi(ceiling_env) != 0;
+    const bool force_loop_copy = loop_copy_env && atoi(loop_copy_env) != 0;
+    double total_abs_err = 0.0;
+    float max_abs_err = 0.0f;
+    size_t err_count = 0;
+    bool first_mismatch_logged = false;
+
+    GGML_ASSERT(width == layer->row_width);
+
+    for (uint32_t si = 0; si < uint32_t(dst->ne[3]); ++si) {
+        const uint32_t abs_si = layer->view_s0 + si;
+        for (uint32_t slot = 0; slot < uint32_t(dst->ne[2]); ++slot) {
+            const llama_kv_cache::tq_v_group * row = nullptr;
+            for (const auto & candidate : layer->sidecar.rows) {
+                if (candidate.slot == slot && candidate.strm == abs_si) {
+                    row = &candidate;
+                    break;
+                }
+            }
+            if (row == nullptr) {
+                continue;
+            }
+
+            layer->decode_rows += 1;
+
+            size_t bit_cursor = row->payload_offset * 8u;
+            size_t byte_cursor = row->payload_offset;
+            size_t scale_index = row->scale_offset;
+            uint32_t code_index = 0;
+
+            for (uint32_t base = 0; base < width; base += group_size) {
+                if (ceiling_raw) {
+                    const uint32_t group_width = std::min<uint32_t>(group_size, width - base);
+                    for (uint32_t j = 0; j < group_width; ++j) {
+                        const uint32_t flat = base + j;
+                        const uint32_t i0 = flat % head_width;
+                        const uint32_t i1 = flat / head_width;
+                        if (force_loop_copy) {
+                            const float out = tq_tensor_get_f32(src, i0, i1, slot, si);
+                            tq_tensor_set_f32(dst, i0, i1, slot, si, out);
+                        } else {
+                            const size_t elem_size = ggml_type_size(dst->type);
+                            const size_t off = tq_tensor_offset(dst, i0, i1, slot, si);
+                            char * dst_ptr = static_cast<char *>(dst->data) + off;
+                            GGML_ASSERT(byte_cursor + elem_size <= layer->sidecar.payload.size());
+                            memcpy(dst_ptr, layer->sidecar.payload.data() + byte_cursor, elem_size);
+                            byte_cursor += elem_size;
+                        }
+                        if (trace_error && atoi(trace_error) != 0) {
+                            const float ref = tq_tensor_get_f32(src, i0, i1, slot, si);
+                            const float out = tq_tensor_get_f32(dst, i0, i1, slot, si);
+                            const float abs_err = fabsf(ref - out);
+                            total_abs_err += abs_err;
+                            max_abs_err = std::max(max_abs_err, abs_err);
+                            ++err_count;
+                            if (!first_mismatch_logged && trace_first && atoi(trace_first) != 0 && abs_err > 0.0f) {
+                                fprintf(stderr,
+                                        "turboquant_first_mismatch: layer=%u abs_si=%u slot=%u i1=%u i0=%u ref=% .8e out=% .8e abs=% .8e payload_off=%zu byte_cursor=%zu loop_copy=%u\n",
+                                        layer->il, abs_si, slot, i1, i0, double(ref), double(out), double(abs_err), row->payload_offset, byte_cursor, force_loop_copy ? 1u : 0u);
+                                first_mismatch_logged = true;
+                            }
+                        }
+                    }
+                    continue;
+                }
+                GGML_ASSERT(scale_index + 1 < layer->sidecar.scales_fp16.size());
+                const tq_codec_mode codec_mode = tq_codec_mode_current();
+                const bool use_projection = codec_mode == tq_codec_mode::projection;
+                const bool use_residual = codec_mode == tq_codec_mode::residual;
+                const float vmin = ggml_fp16_to_fp32(layer->sidecar.scales_fp16[scale_index++]);
+                const float scale = ggml_fp16_to_fp32(layer->sidecar.scales_fp16[scale_index++]);
+                const uint32_t group_width = std::min<uint32_t>(group_size, width - base);
+                std::vector<float> decoded(group_width, vmin);
+
+                for (uint32_t j = 0; j < group_width; ++j) {
+                    float out = vmin;
+                    if (code_index < row->code_count) {
+                        const uint32_t packed0 = tq_unpack_bits(layer->sidecar.payload, bit_cursor, bits);
+                        bit_cursor += bits;
+                        out = vmin + float(packed0) * scale;
+                        ++code_index;
+                    }
+                    decoded[j] = out;
+                }
+
+                if (use_residual) {
+                    GGML_ASSERT(scale_index + 1 < layer->sidecar.scales_fp16.size());
+                    const float rmin = ggml_fp16_to_fp32(layer->sidecar.scales_fp16[scale_index++]);
+                    const float rscale = ggml_fp16_to_fp32(layer->sidecar.scales_fp16[scale_index++]);
+                    for (uint32_t j = 0; j < group_width; ++j) {
+                        float out = rmin;
+                        if (code_index < row->code_count) {
+                            const uint32_t packed1 = tq_unpack_bits(layer->sidecar.payload, bit_cursor, bits);
+                            bit_cursor += bits;
+                            out = rmin + float(packed1) * rscale;
+                            ++code_index;
+                        }
+                        decoded[j] += out;
+                    }
+                }
+
+                if (use_projection && decoded.size() > 1 && ggml_is_power_of_2((int) decoded.size())) {
+                    tq_fwht_norm(decoded);
+                }
+
+                for (uint32_t j = 0; j < group_width; ++j) {
+                    const float out = decoded[j];
+                    const uint32_t flat = base + j;
+                    const uint32_t i0 = flat % head_width;
+                    const uint32_t i1 = flat / head_width;
+                    if (trace_error && atoi(trace_error) != 0) {
+                        const float ref = tq_tensor_get_f32(src, i0, i1, slot, si);
+                        const float abs_err = fabsf(ref - out);
+                        total_abs_err += abs_err;
+                        max_abs_err = std::max(max_abs_err, abs_err);
+                        ++err_count;
+                        if (!first_mismatch_logged && trace_first && atoi(trace_first) != 0 && abs_err > 0.0f) {
+                            fprintf(stderr,
+                                    "turboquant_first_mismatch: layer=%u abs_si=%u slot=%u i1=%u i0=%u ref=% .8e out=% .8e abs=% .8e payload_off=%zu bit_cursor=%zu\n",
+                                    layer->il, abs_si, slot, i1, i0, double(ref), double(out), double(abs_err), row->payload_offset, bit_cursor);
+                            first_mismatch_logged = true;
+                        }
+                    }
+                    tq_tensor_set_f32(dst, i0, i1, slot, si, out);
+                }
+            }
+        }
+    }
+
+    const char * trace_read = getenv("LLAMA_TQ_TRACE_READ");
+    if (trace_read && atoi(trace_read) != 0) {
+        fprintf(stderr,
+                "turboquant_read: layer=%u decode_calls=%zu decode_rows=%zu raw_evicted=%u rows=%zu\n",
+                layer->il,
+                layer->decode_calls,
+                layer->decode_rows,
+                layer->raw_evicted ? 1u : 0u,
+                layer->rows_written);
+    }
+    if (trace_error && atoi(trace_error) != 0 && err_count > 0) {
+        fprintf(stderr,
+                "turboquant_error: layer=%u samples=%zu mean_abs=%.8f max_abs=%.8f\n",
+                layer->il,
+                err_count,
+                total_abs_err / double(err_count),
+                double(max_abs_err));
+    }
+}
