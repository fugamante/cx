+size_t llama_kv_cache::turboquant_sidecar_bytes() const {
+    size_t total = 0;
+    for (const auto & layer : tq_v_layers) {
+        total += layer.payload_bytes + layer.scale_bytes;
+    }
+    return total;
+}
+
+size_t llama_kv_cache::turboquant_simulated_bytes() const {
+    size_t total = 0;
+    for (const auto & layer : tq_v_layers) {
+        total += layer.simulated_bytes;
+    }
+    return total;
+}
