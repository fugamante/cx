+static void tq_v0_identity_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    GGML_UNUSED(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+    GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(src));
+
+    memcpy(dst->data, src->data, ggml_nbytes(src));
+}
+
+static void tq_v0_zero_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    GGML_UNUSED(src);
+    GGML_UNUSED(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(nth >= 1);
+    memset(dst->data, 0, ggml_nbytes(dst));
+}
+
+static size_t tq_tensor_offset(const ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
+    return size_t(i0)*tensor->nb[0] + size_t(i1)*tensor->nb[1] + size_t(i2)*tensor->nb[2] + size_t(i3)*tensor->nb[3];
+}
+
+static float tq_tensor_get_f32(const ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3) {
+    const size_t off = tq_tensor_offset(tensor, i0, i1, i2, i3);
+    const char * base = static_cast<const char *>(tensor->data) + off;
+
+    switch (tensor->type) {
+        case GGML_TYPE_F32:
+            return *reinterpret_cast<const float *>(base);
+        case GGML_TYPE_F16:
+            return ggml_fp16_to_fp32(*reinterpret_cast<const ggml_fp16_t *>(base));
+        default:
+            GGML_ABORT("unsupported tq tensor type");
+    }
+}
+
+static void tq_tensor_set_f32(ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2, int64_t i3, float value) {
+    const size_t off = tq_tensor_offset(tensor, i0, i1, i2, i3);
+    char * base = static_cast<char *>(tensor->data) + off;
+
+    switch (tensor->type) {
+        case GGML_TYPE_F32:
+            *reinterpret_cast<float *>(base) = value;
+            return;
+        case GGML_TYPE_F16:
+            *reinterpret_cast<ggml_fp16_t *>(base) = ggml_fp32_to_fp16(value);
+            return;
+        default:
+            GGML_ABORT("unsupported tq tensor type");
+    }
+}
+
+static void tq_pack_bits(std::vector<uint8_t> & dst, size_t & bit_cursor, uint32_t value, uint32_t bits);
+
+static void tq_v0_simulate_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    auto * params = static_cast<llama_kv_cache::tq_v_layer_state *>(userdata);
+
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(params != nullptr);
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+
+    params->row_width = uint32_t(src->ne[0] * src->ne[1]);
+    params->row_count = uint32_t(src->ne[2] * src->ne[3]);
+    params->raw_bytes = ggml_nbytes(src);
+    params->payload_bytes = 0;
+    params->scale_bytes = 0;
+    params->rows_written = 0;
+    params->rows_bypassed = 0;
+    params->sidecar.payload.clear();
+    params->sidecar.scales_fp16.clear();
+    params->sidecar.rows.clear();
+
+    const int64_t * v_idx_data = nullptr;
+    size_t v_idx_count = 0;
+    if (params->pending_v_idxs != nullptr) {
+        GGML_ASSERT(params->pending_v_idxs->type == GGML_TYPE_I64);
+        v_idx_data = static_cast<const int64_t *>(params->pending_v_idxs->data);
+        v_idx_count = ggml_nelements(params->pending_v_idxs);
+    }
+
+    const uint32_t group_size = std::max<uint32_t>(1, params->group_size);
+    const uint32_t codebook_bits = std::max<uint32_t>(1, params->codebook_bits);
+    const int32_t qmax = std::max<int32_t>(1, (1 << (std::min<uint32_t>(codebook_bits, 15u) - 1)) - 1);
+
+    std::vector<float> group;
+    group.reserve(group_size);
+    size_t row_bit_cursor = 0;
+
+    auto flush_group = [&](std::vector<std::array<int64_t, 4>> & coords) {
+        if (group.empty()) {
+            return;
+        }
+
+        float max_abs = 0.0f;
+        for (float v : group) {
+            max_abs = std::max(max_abs, std::fabs(v));
+        }
+
+        const float scale = max_abs > 0.0f ? (max_abs / float(qmax)) : 0.0f;
+        params->sidecar.scales_fp16.push_back(ggml_fp32_to_fp16(scale));
+
+        for (size_t i = 0; i < group.size(); ++i) {
+            float out = 0.0f;
+            uint32_t packed = 0;
+            if (scale > 0.0f) {
+                const float qf = std::round(group[i] / scale);
+                const float qc = std::max(-float(qmax), std::min(float(qmax), qf));
+                out = qc * scale;
+                packed = uint32_t(int32_t(qc) + qmax);
+            }
+            tq_pack_bits(params->sidecar.payload, row_bit_cursor, packed, codebook_bits);
+            const auto & c = coords[i];
+            tq_tensor_set_f32(dst, c[0], c[1], c[2], c[3], out);
+        }
+
+        group.clear();
+        coords.clear();
+    };
+
+    std::vector<std::array<int64_t, 4>> coords;
+    coords.reserve(group_size);
+    llama_kv_cache::tq_v_group row;
+    bool row_open = false;
+    size_t row_linear = 0;
+
+    for (int64_t i3 = 0; i3 < dst->ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < dst->ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < dst->ne[1]; ++i1) {
+                if (!row_open) {
+                    row = {};
+                    if (v_idx_data != nullptr && row_linear < v_idx_count && params->kv_size > 0) {
+                        const int64_t absolute = v_idx_data[row_linear];
+                        GGML_ASSERT(absolute >= 0);
+                        row.slot = uint32_t(absolute % params->kv_size);
+                        row.strm = uint32_t(absolute / params->kv_size);
+                    } else {
+                        row.slot = uint32_t(i2);
+                        row.strm = uint32_t(i3);
+                    }
+                    row.width = uint32_t(dst->ne[0] * dst->ne[1]);
+                    row.payload_offset = params->sidecar.payload.size();
+                    row.scale_offset = params->sidecar.scales_fp16.size();
+                    row_bit_cursor = row.payload_offset * 8u;
+                    row_open = true;
+                }
+                for (int64_t i0 = 0; i0 < dst->ne[0]; ++i0) {
+                    group.push_back(tq_tensor_get_f32(src, i0, i1, i2, i3));
+                    coords.push_back({i0, i1, i2, i3});
+
+                    if (group.size() == group_size) {
+                        flush_group(coords);
+                    }
+                }
+            }
+            if (row_open) {
+                row.code_count = row.width;
+                row.payload_bytes = params->sidecar.payload.size() - row.payload_offset;
+                row.scale_count = params->sidecar.scales_fp16.size() - row.scale_offset;
+                params->sidecar.rows.push_back(row);
+                ++params->rows_written;
+                ++row_linear;
+                row_open = false;
+            }
+        }
+    }
+
+    flush_group(coords);
+    params->payload_bytes = params->sidecar.payload.size();
+    params->scale_bytes = params->sidecar.scales_fp16.size() * sizeof(uint16_t);
+    params->simulated_bytes = params->payload_bytes + params->scale_bytes;
+    params->pending_v_idxs = nullptr;
+
+    const char * tq_report = getenv("LLAMA_TQ_REPORT");
+    if (tq_report && atoi(tq_report) != 0) {
+        const size_t sidecar_bytes = params->payload_bytes + params->scale_bytes;
+        const double raw_ratio = params->raw_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(params->raw_bytes)) : 0.0;
+        const double sim_ratio = params->simulated_bytes > 0 ? (100.0 * double(sidecar_bytes) / double(params->simulated_bytes)) : 0.0;
+        fprintf(stderr,
+                "turboquant_report: layer=%u rows=%zu raw=%zu sidecar=%zu simulated=%zu raw_ratio=%.2f sim_ratio=%.2f bypassed=%zu\n",
+                params->il,
+                params->rows_written,
+                params->raw_bytes,
+                sidecar_bytes,
+                params->simulated_bytes,
+                raw_ratio,
+                sim_ratio,
+                params->rows_bypassed);
+    }
+}
+
+static void tq_pack_bits(std::vector<uint8_t> & dst, size_t & bit_cursor, uint32_t value, uint32_t bits) {
+    if (bits == 0) {
+        return;
+    }
+    for (uint32_t i = 0; i < bits; ++i) {
+        const uint32_t bit = (value >> i) & 1u;
+        const size_t byte_idx = bit_cursor / 8u;
+        const uint32_t bit_idx = bit_cursor % 8u;
+        if (byte_idx >= dst.size()) {
+            dst.push_back(0);
+        }
+        dst[byte_idx] |= uint8_t(bit << bit_idx);
+        ++bit_cursor;
+    }
+}
+
+static uint32_t tq_unpack_bits(const std::vector<uint8_t> & src, size_t bit_offset, uint32_t bits) {
+    uint32_t value = 0;
+    for (uint32_t i = 0; i < bits; ++i) {
+        const size_t bit_index = bit_offset + i;
+        const size_t byte_idx = bit_index / 8u;
+        const uint32_t byte_bit = bit_index % 8u;
+        if (byte_idx >= src.size()) {
+            break;
+        }
+        const uint32_t bit = (src[byte_idx] >> byte_bit) & 1u;
+        value |= (bit << i);
+    }
+    return value;
+}
+
+static void tq_v0_sidecar_map(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int nth,
+        void * userdata) {
+    auto * layer = static_cast<llama_kv_cache::tq_v_layer_state *>(userdata);
+    if (ith != 0) {
+        return;
+    }
+
+    GGML_ASSERT(layer != nullptr);
+    GGML_ASSERT(nth >= 1);
+    GGML_ASSERT(dst->type == src->type);
+    GGML_ASSERT(ggml_nbytes(dst) == ggml_nbytes(src));
+
+    memcpy(dst->data, src->data, ggml_nbytes(src));
+
+    layer->decode_calls += 1;
+
+    const uint32_t group_size = std::max<uint32_t>(1, layer->group_size);
+    const uint32_t bits = std::max<uint32_t>(1, layer->codebook_bits);
+    const int32_t qmax = std::max<int32_t>(1, (1 << (std::min<uint32_t>(bits, 15u) - 1)) - 1);
+    const uint32_t head_width = uint32_t(dst->ne[0]);
+    const uint32_t n_head = uint32_t(dst->ne[1]);
+    const uint32_t width = head_width * n_head;
+    const char * trace_error = getenv("LLAMA_TQ_TRACE_ERROR");
+    double total_abs_err = 0.0;
+    float max_abs_err = 0.0f;
+    size_t err_count = 0;
+
+    GGML_ASSERT(width == layer->row_width);
+
+    for (uint32_t si = 0; si < uint32_t(dst->ne[3]); ++si) {
+        for (uint32_t slot = 0; slot < uint32_t(dst->ne[2]); ++slot) {
+            const llama_kv_cache::tq_v_group * row = nullptr;
+            for (const auto & candidate : layer->sidecar.rows) {
+                if (candidate.slot == slot && candidate.strm == si) {
+                    row = &candidate;
+                    break;
+                }
+            }
+            if (row == nullptr) {
+                continue;
+            }
+
+            layer->decode_rows += 1;
+
+            size_t bit_cursor = row->payload_offset * 8u;
+            size_t scale_index = row->scale_offset;
+            uint32_t code_index = 0;
+
+            for (uint32_t base = 0; base < width; base += group_size) {
+                GGML_ASSERT(scale_index < layer->sidecar.scales_fp16.size());
+                const float scale = ggml_fp16_to_fp32(layer->sidecar.scales_fp16[scale_index++]);
+                const uint32_t group_width = std::min<uint32_t>(group_size, width - base);
+
+                for (uint32_t j = 0; j < group_width; ++j) {
+                    float out = 0.0f;
+                    if (code_index < row->code_count) {
+                        const uint32_t packed = tq_unpack_bits(layer->sidecar.payload, bit_cursor, bits);
+                        const int32_t qc = int32_t(packed) - qmax;
+                        out = float(qc) * scale;
+                        bit_cursor += bits;
+                        ++code_index;
+                    }
+
+                    const uint32_t flat = base + j;
+                    const uint32_t i0 = flat % head_width;
+                    const uint32_t i1 = flat / head_width;
+                    if (trace_error && atoi(trace_error) != 0) {
+                        const float ref = tq_tensor_get_f32(src, i0, i1, slot, si);
+                        const float abs_err = fabsf(ref - out);
+                        total_abs_err += abs_err;
+                        max_abs_err = std::max(max_abs_err, abs_err);
+                        ++err_count;
+                    }
+                    tq_tensor_set_f32(dst, i0, i1, slot, si, out);
+                }
+            }
+        }
+    }
+
+    const char * trace_read = getenv("LLAMA_TQ_TRACE_READ");
+    if (trace_read && atoi(trace_read) != 0) {
+        fprintf(stderr,
+                "turboquant_read: layer=%u decode_calls=%zu decode_rows=%zu raw_evicted=%u rows=%zu\n",
+                layer->il,
+                layer->decode_calls,
+                layer->decode_rows,
+                layer->raw_evicted ? 1u : 0u,
+                layer->rows_written);
+    }
+    if (trace_error && atoi(trace_error) != 0 && err_count > 0) {
+        fprintf(stderr,
+                "turboquant_error: layer=%u samples=%zu mean_abs=%.8f max_abs=%.8f\n",
+                layer->il,
+                err_count,
+                total_abs_err / double(err_count),
+                double(max_abs_err));
+    }
+}
